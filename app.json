{
  "expo": {
    "name": "DolphinLingo",
    "slug": "penguinlingo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/dolphin-app-icon.png",
    "scheme": "flashcardapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dolphinlingo.flashcardapp.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dolphinlingo.flashcardapp.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#63DDE0",
        "foregroundImage": "./assets/images/dolphin-app-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/dolphin-app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-system-ui",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/dolphin-app-icon-foreground.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#DDFBFA",
          "dark": {
            "backgroundColor": "#08253D"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9247fb65-9625-4414-8964-ec4ab60931b9"
      }
    },
    "owner": "duyhuu46s-team"
  }
}
