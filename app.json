{
  "expo": {
    "name": "Penguinlingo",
    "slug": "penguinlingo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/dolphin-app-icon.png",
    "scheme": "flashcardapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.penguinlingo.flashcardapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#63DDE0",
        "foregroundImage": "./assets/images/dolphin-app-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.lexiloop.flashcardapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/dolphin-app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/dolphin-app-icon-foreground.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#DDFBFA",
          "dark": {
            "backgroundColor": "#08253D"
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
